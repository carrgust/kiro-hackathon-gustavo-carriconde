# Database
DATABASE_URL="postgresql://curatos:curatos_dev_password@localhost:5432/curatos_dev"

# Prisma
PRISMA_GENERATE_DATAPROXY="false"

# OpenRouter API (Required)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Backup API Key (Optional)
OPENROUTER_API_KEY_BACKUP="your_backup_openrouter_api_key_here"

# Serper API (Optional but recommended for web search)
# Get free key at https://serper.dev (2,500 free searches)
SERPER_API_KEY="your_serper_api_key_here"

# NextAuth Secret (Required for authentication)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Product Hunt API (Optional)
PRODUCTHUNT_TOKEN="your_producthunt_token_here"
